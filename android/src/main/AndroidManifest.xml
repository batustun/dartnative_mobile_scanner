<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Declared by the plugin so a consuming app needs no manifest change. The
        plugin requests it at runtime and reports a refusal as a typed error.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        required="false" so an app using this plugin is still installable on a
        device with no camera. The scanner reports cameraUnavailable there instead
        of the app being filtered out of the store listing.
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

</manifest>
